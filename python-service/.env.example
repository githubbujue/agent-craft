# AI Embeddings
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY

# LLM (对话模型) —— 走百炼 OpenAI 兼容端点, 同一端点兼容通义 / DeepSeek / Kimi 等托管模型
# 换模型: 只改 LLM_MODEL 即可, 无需动代码 (例: qwen-plus / kimi-k2-0905-preview / deepseek-v3)
LLM_MODEL=deepseek-v4.1-flash
# 换厂商时再配下面两项(不配则沿用 DASHSCOPE_API_KEY 与百炼端点)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=your_api_key

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Optional: Milvus Authentication (if enabled)
# MILVUS_USER=username
# MILVUS_PASSWORD=password

# Vector Store Selection (true for Milvus, false for FAISS)
# 默认使用 FAISS（零依赖，本地运行），需要生产级性能可切换 Milvus
USE_MILVUS=false

# Vector Store Configuration
VECTOR_STORE_PERSIST_DIR=./faiss_index
VECTOR_STORE_COLLECTION_NAME=ai_knowledge_collection

# Rerank Configuration
# Rerank type: 'bge' (recommended, local), 'cohere' (requires API key), 'simple' (fallback), 'none' (disabled)
# bge 效果最好但首次需下载 ~1.1GB 模型，开发环境建议用 simple
RERANKER_TYPE=simple

# Faithfulness Judge (LLM-as-judge 内容忠实度评估 —— 后台异步执行, 不阻塞主链路)
# false 可整体关闭; 采样率 0.0~1.0 控制评判比例(全量评判有 token 成本, 生产可调低)
FAITHFULNESS_JUDGE_ENABLED=true
FAITHFULNESS_JUDGE_SAMPLE_RATE=1.0

# Optional: Cohere API Key (if using Cohere reranker)
# COHERE_API_KEY=your_cohere_api_key

# 联网补救 (仅知识库完全零命中时启用; 未配 key 时整条链路自动跳过, 对既有行为零回归)
# WEB_SEARCH_MODE 三选一:
#   bailian  百炼服务端检索并注入 prompt —— 零配置可用, 但拿不到来源链接
#   tool     调用本项目 WebSearchTool(Tavily) —— 可产出结构化引用来源(可点击)
#   off      不联网
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MODE=bailian
# tool 模式必填 (https://tavily.com 注册即得); 填了 key 再把 MODE 改成 tool
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_TOP_K=5

# Text Chunking Configuration
# Chunk strategy: 'semantic' (recommended), 'recursive' (default)
CHUNK_STRATEGY=semantic
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100

# Tesseract OCR Configuration
# Tesseract executable path（留空则自动检测常见安装路径）
TESSERACT_PATH=

# Temporary Files Configuration
TEMP_DIR=./temp

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
